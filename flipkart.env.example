# ==============================================================================
# Flipkart Seller & Ads API Credentials Template
# Nevisan Tea - https://nevisan.in
# 
# Instructions:
# 1. Copy this file to .env:
#    cp flipkart.env.example .env   (or Copy-Item flipkart.env.example .env)
# 2. Fill in your credentials provided by Flipkart Developer Admin.
# 3. Keep .env confidential. It is already ignored by .gitignore.
# ==============================================================================

# Your Flipkart Developer Application Client ID
FLIPKART_CLIENT_ID=your_client_id_here

# Your Flipkart Developer Application Client Secret
FLIPKART_CLIENT_SECRET=your_client_secret_here

# Pre-registered HTTPS Redirect URI on GitHub Pages
FLIPKART_REDIRECT_URI=https://nevisan.in/oauth/callback/

# Optional: Preferred target ROAS multiplier for ad automation scripts
FLIPKART_TARGET_ROAS=3.5
